        "estimated_next_cost_micros": 500,
        "thresholds": {
          "warn_micros": 1000,
          "approval_micros": 2000,
          "hard_stop_micros": 3000
        },
        "approval": {
          "status": "approved",
          "subject_digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
