    {
      "id": "VERIFICATION-001",
      "gate": "verification",
      "title": "Independent subject-bound evidence with PASS authorizes completion",
      "input": {
        "subject_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "implementer_id": "implementer-a",
        "report": {
          "subject_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "verifier_id": "verifier-b",
          "evidence": [
            {
              "command": "npm test",
              "output": "fixture checks passed",
              "result": "PASS"
            }
          ],
          "verdict": "PASS"
        }
      },
      "expected": {
        "outcome": "allow",
        "code": "verification.passed",
        "effects": [
          "record_verification_receipt"
        ]
      }
    },
    {
      "id": "VERIFICATION-002",
      "gate": "verification",
      "title": "Implementer cannot self-verify completion",
      "input": {
        "subject_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "implementer_id": "implementer-a",
        "report": {
          "subject_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "verifier_id": "implementer-a",
          "evidence": [
            {
              "command": "npm test",
              "output": "fixture checks passed",
              "result": "PASS"
            }
          ],
          "verdict": "PASS"
        }
      },
      "expected": {
        "outcome": "block",
        "code": "verification.independence_required",
        "effects": [
          "stop_completion"
        ]
      }
    },
    {
      "id": "VERIFICATION-003",
      "gate": "verification",
      "title": "Verification of a stale implementation cannot authorize completion",
      "input": {
        "subject_digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
        "implementer_id": "implementer-a",
        "report": {
          "subject_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "verifier_id": "verifier-b",
          "evidence": [
            {
              "command": "npm test",
              "output": "29 tests passed",
              "result": "PASS"
            }
          ],
          "verdict": "PASS"
        }
      },
      "expected": {
        "outcome": "block",
        "code": "verification.stale_subject",
        "effects": [
          "stop_completion",
          "request_new_verification"
        ]
      }
    },
    {
      "id": "VERIFICATION-004",
      "gate": "verification",
      "title": "Narrative verdict without evidence cannot authorize completion",
      "input": {
        "subject_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "implementer_id": "implementer-a",
        "report": {
          "subject_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "verifier_id": "verifier-b",
          "evidence": [],
          "verdict": "PASS"
        }
      },
      "expected": {
        "outcome": "block",
        "code": "verification.evidence_required",
        "effects": [
          "stop_completion"
        ]
      }
    },
    {
      "id": "VERIFICATION-005",
      "gate": "verification",
      "title": "Partial verdict cannot authorize completion",
      "input": {
        "subject_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "implementer_id": "implementer-a",
        "report": {
          "subject_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "verifier_id": "verifier-b",
          "evidence": [
            {
              "command": "npm test",
              "output": "28 passed, 1 skipped",
