        "effects": [
          "stop_execution"
        ]
      }
    },
    {
      "id": "WORKFLOW-001",
      "gate": "workflow",
      "title": "Every mutation gate must allow before mutation",
      "input": {
        "boundary": "mutation",
        "gate_results": {
          "plan": "allow",
          "permission": "allow",
          "tool_trust": "allow",
          "runtime": "allow"
        }
      },
      "expected": {
        "outcome": "allow",
        "code": "workflow.mutation_authorized",
        "effects": [
          "record_mutation_authorization"
        ]
      }
    },
    {
      "id": "WORKFLOW-002",
      "gate": "workflow",
      "title": "Any mutation ask pauses the composed workflow",
      "input": {
        "boundary": "mutation",
        "gate_results": {
          "plan": "allow",
          "permission": "ask",
          "tool_trust": "allow",
          "runtime": "allow"
        }
      },
      "expected": {
        "outcome": "ask",
        "code": "workflow.mutation_requires_approval",
        "effects": [
          "pause_mutation"
        ]
      }
    },
    {
      "id": "WORKFLOW-003",
      "gate": "workflow",
      "title": "Any mutation block outranks ask and stops the workflow",
      "input": {
        "boundary": "mutation",
        "gate_results": {
          "plan": "block",
          "permission": "ask",
          "tool_trust": "allow",
          "runtime": "allow"
        }
      },
      "expected": {
        "outcome": "block",
        "code": "workflow.mutation_blocked",
        "effects": [
          "stop_mutation"
        ]
      }
    },
    {
      "id": "WORKFLOW-004",
      "gate": "workflow",
      "title": "Authorized mutation plus passed verification permits completion",
      "input": {
        "boundary": "completion",
        "mutation_authorized": true,
        "gate_results": {
          "verification": "allow"
        }
      },
      "expected": {
        "outcome": "allow",
        "code": "workflow.completion_authorized",
        "effects": [
          "record_completion"
        ]
      }
    },
    {
      "id": "WORKFLOW-005",
      "gate": "workflow",
      "title": "Failed verification prevents completion",
      "input": {
        "boundary": "completion",
        "mutation_authorized": true,
        "gate_results": {
          "verification": "block"
        }
      },
      "expected": {
        "outcome": "block",
        "code": "workflow.verification_failed",
        "effects": [
          "stop_completion"
        ]
      }
    },
    {
      "id": "WORKFLOW-006",
      "gate": "workflow",
      "title": "Verification cannot complete an unauthorized mutation",
      "input": {
        "boundary": "completion",
        "mutation_authorized": false,
        "gate_results": {
          "verification": "allow"
        }
      },
      "expected": {
        "outcome": "block",
        "code": "workflow.mutation_not_authorized",
        "effects": [
          "stop_completion"
        ]
      }
    },
    {
      "id": "WORKFLOW-007",
      "gate": "workflow",
      "title": "Missing mutation gate result fails closed",
      "input": {
        "boundary": "mutation",
        "gate_results": {
          "plan": "allow",
          "permission": "allow",
          "tool_trust": "allow"
        }
      },
      "expected": {
        "outcome": "block",
        "code": "workflow.invalid_input",
        "effects": [
          "stop_mutation"
        ]
      }
    }
  ],
  "mutants": [
    {
      "id": "skip_plan",
      "gate": "plan",
      "unsafe_behavior": "Allow mutation without exact plan approval."
    },
    {
      "id": "allow_unknown_permission",
      "gate": "permission",
      "unsafe_behavior": "Treat an unknown action as allowed."
    },
    {
      "id": "trust_by_capability_name",
      "gate": "tool_trust",
      "unsafe_behavior": "Trust a changed capability when only its display name matches."
    },
    {
      "id": "allow_self_verification",
      "gate": "verification",
      "unsafe_behavior": "Allow the implementer to verify its own work."
    },
    {
      "id": "fail_open_missing_usage",
      "gate": "runtime",
      "unsafe_behavior": "Continue when usage data is missing."
    }
  ]
}
