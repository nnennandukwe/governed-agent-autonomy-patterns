          "notify_operator"
        ]
      }
    },
    {
      "id": "RUNTIME-003",
      "gate": "runtime",
      "title": "Approval threshold pauses without exact overage approval",
      "input": {
        "action_digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
        "usage_status": "known",
        "current_cost_micros": 1500,
        "estimated_next_cost_micros": 600,
        "thresholds": {
          "warn_micros": 1000,
          "approval_micros": 2000,
