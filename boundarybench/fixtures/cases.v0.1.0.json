    {
      "id": "RUNTIME-001",
      "gate": "runtime",
      "title": "Known projected spend below warning threshold proceeds",
      "input": {
        "action_digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
        "usage_status": "known",
        "current_cost_micros": 400,
        "estimated_next_cost_micros": 500,
        "thresholds": {
          "warn_micros": 1000,
          "approval_micros": 2000,
          "hard_stop_micros": 3000
        },
        "approval": null
      },
      "expected": {
        "outcome": "allow",
        "code": "runtime.within_budget",
        "effects": []
      }
    },
    {
      "id": "RUNTIME-002",
      "gate": "runtime",
      "title": "Warning threshold proceeds with operator notification",
      "input": {
        "action_digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
        "usage_status": "known",
        "current_cost_micros": 800,
        "estimated_next_cost_micros": 400,
        "thresholds": {
          "warn_micros": 1000,
          "approval_micros": 2000,
          "hard_stop_micros": 3000
